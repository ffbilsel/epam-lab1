PORT=3000
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1h
RESET_TOKEN_TTL_MINUTES=30
NODE_ENV=development

# Optional SMTP. If unset, password-reset links are logged to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Auth Demo <no-reply@example.com>"

# Frontend dev server origin (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Public app URL used in reset-password emails
APP_URL=http://localhost:5173
